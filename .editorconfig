# Shared editor settings (https://editorconfig.org): most editors pick these up automatically.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ps1,iss}]
end_of_line = crlf

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
